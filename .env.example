# omini AI bot — konfiguratsiya namunasi.
# Qiymatlarni o'zingizniki bilan almashtiring va faylni .env deb saqlang.

# Majburiy
BOT_TOKEN=1234567890:AAA...TelegramBotFather tokeni
GEMINI_API_KEY=AIza...Google AI Studio kaliti

# Admin (bu bo'lmasa bot.py ichidagi default ID ishlatiladi)
ADMIN_ID=8692018182

# AI model. MODEL_LIST orqali /model panelida ko'rinadigan variantlar ro'yxati —
# faqat kalitingizda haqiqatan mavjud bo'lgan nomlarni yozing
# (masalan gemini-2.5-flash endi yangi kalitalarga yopiq: 404 qaytadi).
MODEL_NAME=gemini-3.5-flash-lite
MODEL_LIST=gemini-3.5-flash-lite,gemini-3.8-flash

# Web-qidiruv (google_search grounding) ishlamasa, avtomatik o'chiriladi.
TEMPERATURE=0.8
MAX_OUTPUT_TOKENS=4096

# Ovozli javob (gTTS). Birinchi til ishlamasa, keyingi tilga o'tadi.
TTS_LANGS=uz,tr
MAX_VOICE_CHARS=700

# Spam va xarajat himoyasi
RATE_LIMIT_COUNT=6
RATE_LIMIT_WINDOW=30
DAILY_LIMIT=150

# Haqorat moderasiyasi.
# PROFANITY_MODE: block (1-marta ogohlantirish, keyin vaqtinchalik blok) | warn (faqat ogohlantirish) | off
# PROFANITY_BLOCK_AFTER — nechanchi marta haqoratdan keyin blok qo'yiladi (2 = ikkinchisida).
# PROFANITY_BAN_HOURS — vaqtinchalik blok soatlari, muddat o'tgach o'zi ochiladi.
# PROFANITY_WORDS — qo'shimcha taqiqlangan so'zlar (vergul orasida, kichik harfda).
PROFANITY_MODE=block
PROFANITY_BLOCK_AFTER=2
PROFANITY_BAN_HOURS=24
PROFANITY_WORDS=

# Saqlash va log
DB_PATH=bot_data.db
LOG_FILE=bot.log

# Rasm generatsiyasi.
# IMAGE_PROVIDER: auto (Gemini'ni urib, bo'lmasa pollinations) | gemini (faqat Gemini) | pollinations (faqat bepul)
# Gemini rasmlari sifatli va /edit (rasm tahrirlash) shu model bilan ishlaydi, lekin
# Google AI Studio'da BILLING ulang bo'lishi kerak — aks holda 429 kvota xatosi
# qaytadi va bot avtomatik pollinations'tan chizadi (6 soatga Gemini o'chiriladi).
IMAGE_PROVIDER=auto
IMAGE_MODEL=gemini-3.1-flash-image
IMAGE_MODEL_FALLBACK=gemini-2.5-flash-image

# pollinations.ai (bepul yo'l) uchun kutish sekundlari
IMAGE_TIMEOUT=120

# Render/Railway kabi hostinglarda keep-alive porti
PORT=8080
