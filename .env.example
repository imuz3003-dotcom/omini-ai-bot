# omini AI bot — konfiguratsiya namunasi.
# Qiymatlarni o'zingizniki bilan almashtiring va faylni .env deb saqlang.

# Majburiy
BOT_TOKEN=1234567890:AAA...TelegramBotFather tokeni
GEMINI_API_KEY=AIza...Google AI Studio kaliti

# Admin (bu bo'lmasa bot.py ichidagi default ID ishlatiladi)
ADMIN_ID=8692018182

# AI model. MODEL_LIST orqali /model panelida ko'rinadigan variantlar ro'yxati —
# faqat kalitingizda haqiqatan mavjud bo'lgan nomlarni yozing.
MODEL_NAME=gemini-3.5-flash-lite
MODEL_LIST=gemini-3.5-flash-lite,gemini-2.5-flash

# Web-qidiruv (google_search grounding) ishlamasa, avtomatik o'chiriladi.
TEMPERATURE=0.8
MAX_OUTPUT_TOKENS=4096

# Ovozli javob (gTTS). Birinchi til ishlamasa, keyingi tilga o'tadi.
TTS_LANGS=uz,tr
MAX_VOICE_CHARS=700

# Spam va xarajat himoyasi
RATE_LIMIT_COUNT=6
RATE_LIMIT_WINDOW=30
DAILY_LIMIT=150

# Saqlash va log
DB_PATH=bot_data.db
LOG_FILE=bot.log

# Rasm generatsiyasi (pollinations.ai) uchun kutish sekundlari
IMAGE_TIMEOUT=120

# Render/Railway kabi hostinglarda keep-alive porti
PORT=8080
